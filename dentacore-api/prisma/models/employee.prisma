model Employee {
  id             String    @id @default(uuid())
  nationalId     String    @unique
  employeeNumber String    @unique
  password       String
  firstName      String
  middleName     String?
  lastName       String
  activeEmail    String
  addresses      Address[]
  phones         Phone[]
  emails         Email[]
  roles          Role[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleteAt  DateTime?
}
