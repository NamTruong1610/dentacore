model Employee {
  id               String            @id @default(uuid())
  nationalId       String            @unique
  employeeNumber   String            @unique
  passwordHash     String
  firstName        String
  middleName       String?
  lastName         String
  activeEmail      String
  status           Status
  addresses        Address[]
  phones           Phone[]
  emails           Email[]
  roles            Role[]
  activationTokens ActivationToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleteAt  DateTime?
}
