model Role {
  id          String  @id @default(uuid())
  name        String
  description String?

  employee        Employee?        @relation(fields: [employeeId], references: [id])
  employeeId      String?
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
