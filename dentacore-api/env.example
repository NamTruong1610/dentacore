# Copy to .env. docker compose reads .env automatically.

POSTGRES_USER=dentacore
POSTGRES_PASSWORD=dentacore
POSTGRES_DB=dentacore

RABBITMQ_USER=dentacore
RABBITMQ_PASSWORD=dentacore

# Host ports (offset from the defaults to avoid clashing with other Docker projects)
POSTGRES_PORT=5435
REDIS_PORT=6381
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673

# Connection strings for the Nest app running on your machine (npm run start:dev)
DATABASE_URL=postgres://dentacore:dentacore@localhost:5435/dentacore
REDIS_URL=redis://localhost:6381
RABBITMQ_URL=amqp://dentacore:dentacore@localhost:5673
